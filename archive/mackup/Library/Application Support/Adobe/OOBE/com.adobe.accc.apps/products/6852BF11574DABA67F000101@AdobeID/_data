sion"><value>12.0-</value></custom-entry><custom-entry key="tutorialsPage_ru_RU"><value>https://helpx.adobe.com/ru/after-effects/tutorials.html</value></custom-entry><custom-entry key="tutorialsPage_it_IT"><value>https://helpx.adobe.com/it/after-effects/tutorials.html</value></custom-entry><custom-entry key="tutorialsPage_zh_CN"><value>https://helpx.adobe.com/cn/after-effects/tutorials.html</value></custom-entry><custom-entry key="systemRequirementURL"><value>https://helpx.adobe.com/after-effects/system-requirements.html</value></custom-entry><custom-entry key="tutorialsPage_pt_BR"><value>https://helpx.adobe.com/br/after-effects/tutorials.html</value></custom-entry><custom-entry key="tutorialsPage_ja_JP"><value>https://helpx.adobe.com/jp/after-effects/tutorials.html</value></custom-entry><custom-entry key="tutorialsPage_fr_CA"><value>https://helpx.adobe.com/fr/after-effects/tutorials.html</value></custom-entry><custom-entry key="showInPrevVersion"><value>true</value></custom-entry><custom-entry key="tutorialsPage_es_MX"><value>https://helpx.adobe.com/es/after-effects/tutorials.html</value></custom-entry><custom-entry key="productDetailedDescription"><value>{"Language":[{"value":"After Effects (Beta) improves the efficiency of motion graphics creation by streamlining your ability to create data-driven graphics and delivering faster, higher-quality VR results.","locale":"en_US"},{"value":"After Effects (Beta) improves the efficiency of motion graphics creation by streamlining your ability to create data-driven graphics and delivering faster, higher-quality VR results.","locale":"en_GB"},{"value":"After Effects (Beta) improves the efficiency of motion graphics creation by streamlining your ability to create data-driven graphics and delivering faster, higher-quality VR results.","locale":"en_AE"},{"value":"After Effects (Beta) improves the efficiency of motion graphics creation by streamlining your ability to create data-driven graphics and delivering faster, higher-quality VR results.","locale":"en_IL"},{"value":"After Effects (Beta) mejora la productividad a la hora de crear gráficos dinámicos, ya que permite agilizar la creación de gráficos de datos y ofrecer resultados de realidad virtual más rápido y de mayor calidad.","locale":"es_ES"},{"value":"After Effects (Beta) mejora la productividad a la hora de crear gráficos dinámicos, ya que permite agilizar la creación de gráficos de datos y ofrecer resultados de realidad virtual más rápido y de mayor calidad.","locale":"es_MX"},{"value":"After Effects (Beta) verbessert die Effizienz bei der Animationserstellung durch vereinfachte Erstellung datengesteuerter Grafiken und Bereitstellung schnellerer, qualitativ hochwertigerer VR-Resultate.","locale":"de_DE"},{"value":"After Effects (Beta) permet de créer des animations graphiques de manière plus efficace en simplifiant la création de graphiques axés sur les données et en générant plus rapidement des résultats VR de meilleure qualité.","locale":"fr_FR"},{"value":"After Effects (Beta) permet de créer des animations graphiques de manière plus efficace en simplifiant la création de graphiques axés sur les données et en générant plus rapidement des résultats VR de meilleure qualité.","locale":"fr_CA"},{"value":"After Effects (Beta) permet de créer des animations graphiques de manière plus efficace en simplifiant la création de graphiques axés sur les données et en générant plus rapidement des résultats VR de meilleure qualité.","locale":"fr_MA"},{"value":"After Effects (Beta) permette di creare grafica animata in modo più efficiente, semplificando la creazione di grafica basata su dati e fornendo risultati VR più rapidi e di maggiore qualità.","locale":"it_IT"},{"value":"After Effects (Beta) は、データドリブン型グラフィックの作成を能率化し、高速かつ高品質の VR 出力を生成することで、モーショングラフィックスの作成効率を高めます。","locale":"ja_JP"},{"value":"After Effects (Beta) 은 데이터 기반 그래픽 제작 과정을 간소화하고 고품질 VR 결과를 보다 신속하게 제공하여 모션 그래픽 제작 효율을 개선합니다.","locale":"ko_KR"},{"value":"O After Effects (Beta) apresenta um processo de criação de animações aprimorado e mais eficiente, por meio da criação otimizada de gráficos ricos em dados e da entrega mais rápida de resultados de realidade virtual de maior qualidade.","locale":"pt_BR"},{"value":"After Effects (Beta) повышает эффективность создания анимационной графики благодаря оптимизации работы с графикой на основе данных и повышению качества продуктов VR.","locale":"ru_RU"},{"value":"After Effects (Beta) 通过简化数据驱动型图形的创建和实现速度更快、质量更高的 VR 效果，改进了动态图形的创建效率。","locale":"zh_CN"}]}</value></custom-entry><custom-entry key="tutorialsPage_es_ES"><value>https://helpx.adobe.com/es/after-effects/tutorials.html</value></custom-entry><custom-entry key="tutorialsPage_en_GB"><value>https://helpx.adobe.com/after-effects/tutorials.html</value></custom-entry><custom-entry key="tutorialsPage_de_DE"><value>https://helpx.adobe.com/de/after-effects/tutorials.html</value></custom-entry><custom-entry key="tutorialsPage_fr_FR"><value>https://helpx.adobe.com/fr/after-effects/tutorials.html</value></custom-entry><custom-entry key="compatibilityCheckScript"><value>var winChecks={minOSVersion:"10.0.0.14393",osArchitecture:"64",excludedOSVersion1:"10.0.0.15063",excludedOSVersion2:"10.0.0.16299"};var macChecks={minOSVersion:"10.14.0"};var localizationStringMap={cs_CZ:{OperatingSystemWin:"Windows 10 (verze 1903 nebo novější)",OperatingSystemMac:"macOS 10.14 nebo novější"},da_DK:{OperatingSystemWin:"Windows 10 (version 1903 eller nyere)",OperatingSystemMac:"macOS 10.14 eller nyere"},de_DE:{OperatingSystemWin:"Windows 10 (Version 1903 oder höher)",OperatingSystemMac:"macOS 10.14 oder höher"},en_US:{OperatingSystemWin:"Windows 10 (Version 1903 or later)",OperatingSystemMac:"macOS 10.14 or later"},es_ES:{OperatingSystemWin:"Windows 10 (versión 1903 o posterior)",OperatingSystemMac:"macOS 10.14 o posterior"},es_MX:{OperatingSystemWin:"Windows 10 (versión 1903 o posterior)",OperatingSystemMac:"macOS 10.14 o posterior"},fr_FR:{OperatingSystemWin:"Windows 10 (Version