les.","locale":"es_ES"},{"value":"Efecto ducking automático para música en el panel Sonido básico; Rendimiento mejorado para la reproducción y el desplazamiento; Control de entrada y grabación intuitivo; Compatibilidad con Mackie HUI Control Surface; Etiquetas de canal de forma de ondas editables.","locale":"es_MX"},{"value":"Automatisches Ducking von Musik in der Essential-Sound-Konsole; verbesserte Performance bei Scrolling und Wiedergabe; intuitive Eingangsüberwachung und Aufnahme; Unterstützung für den Mackie HUI-Fadercontroller; bearbeitbare Wellenform-Kanalbezeichnungen.","locale":"de_DE"},{"value":"Ducking automatique de la musique dans le panneau Audio essentiel ; performances de défilement et de lecture améliorées ; enregistrement et contrôle d’entrée intuitifs ; prise en charge de la surface de contrôle Mackie HUI ; libellés de canaux de forme d’onde modifiables.","locale":"fr_FR"},{"value":"Ducking automatique de la musique dans le panneau Audio essentiel ; performances de défilement et de lecture améliorées ; enregistrement et contrôle d’entrée intuitifs ; prise en charge de la surface de contrôle Mackie HUI ; libellés de canaux de forme d’onde modifiables.","locale":"fr_CA"},{"value":"Ducking automatique de la musique dans le panneau Audio essentiel ; performances de défilement et de lecture améliorées ; enregistrement et contrôle d’entrée intuitifs ; prise en charge de la surface de contrôle Mackie HUI ; libellés de canaux de forme d’onde modifiables.","locale":"fr_MA"},{"value":"Attenuamento automatico della musica dal pannello Audio essenziale; prestazioni di scorrimento e riproduzione ottimizzate; registrazione e monitoraggio intuitivo dell’input; supporto per la superficie di controllo Mackie HUI; etichette modificabili per i canali forma d’onda.","locale":"it_IT"},{"value":"エッセンシャルサウンドパネルでの音楽の自動ダッキング。スクロールおよび再生パフォーマンスの向上。直感的な入力モニタリングと録音。Mackie HUI コントロールサーフェスのサポート。編集可能な波形チャンネルラベル。","locale":"ja_JP"},{"value":"기본 사운드 패널에서의 음악 자동 더킹, 향상된 스크롤 및 재생 성능, 직관적인 입력 모니터링 및 기록, Mackie HUI 컨트롤 표면 지원, 편집 가능한 파형 채널 레이블.","locale":"ko_KR"},{"value":"Redução automática do volume de músicas no painel Áudio essencial; desempenho aprimorado de rolagem e reprodução; monitoramento e gravação de entrada intuitivos; suporte à plataforma de controle Mackie HUI; rótulos editáveis de canais de forma de onda.","locale":"pt_BR"},{"value":"基本声音面板中的自动闪避音乐；增强的滚动和回放性能；直观的输入监控和录制；Mackie HUI 操纵面支持；可编辑的波形声道标签。","locale":"zh_CN"}]}</value></custom-entry><custom-entry key="tutorialsPage_es_ES"><value>https://helpx.adobe.com/audition/tutorials.html</value></custom-entry><custom-entry key="tutorialsPage_sk_SK"><value>http://www.adobe.com/go/audition-tutorials</value></custom-entry><custom-entry key="tutorialsPage_nb_NO"><value>http://www.adobe.com/go/audition-tutorials_no</value></custom-entry><custom-entry key="tutorialsPage_hu_HU"><value>http://www.adobe.com/go/audition-tutorials</value></custom-entry><custom-entry key="tutorialsPage_de_DE"><value>https://helpx.adobe.com/de/audition/tutorials.html</value></custom-entry><custom-entry key="tutorialsPage_en_GB"><value>https://helpx.adobe.com/audition/tutorials.html</value></custom-entry><custom-entry key="tutorialsPage_uk_UA"><value>http://www.adobe.com/go/audition-tutorials</value></custom-entry><custom-entry key="tutorialsPage_fr_FR"><value>https://helpx.adobe.com/fr/audition/tutorials.html</value></custom-entry><custom-entry key="compatibilityCheckScript"><value>var winChecks={minOSVersion:"10.0.0.14393",osArchitecture:"64",excludedOSVersion1:"10.0.0.15063",excludedOSVersion2:"10.0.0.16299"};var macChecks={minOSVersion:"10.13.0"};var localizationStringMap={cs_CZ:{OperatingSystemWin:"Windows 10 (verze 1803 nebo novější)",OperatingSystemMac:"macOS 10.13 nebo novější"},da_DK:{OperatingSystemWin:"Windows 10 (version 1803 eller nyere)",OperatingSystemMac:"macOS 10.13 eller nyere"},de_DE:{OperatingSystemWin:"Windows 10 (Version 1803 oder höher)",OperatingSystemMac:"macOS 10.13 oder höher"},en_US:{Ope